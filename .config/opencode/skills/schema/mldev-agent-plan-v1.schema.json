{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mldev-agent-plan-v1.schema.json",
  "title": "План MLDev-эксперимента",
  "description": "Формальный план, построенный только на основе кода исходного репозитория.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "hypotheses",
    "artifacts",
    "stages",
    "pipeline",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "mldev-agent-plan/v1"
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "metric",
        "comparison",
        "threshold",
        "stage_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!="
          ]
        },
        "threshold": {
          "type": "number"
        },
        "stage_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "producer",
        "consumers"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "consumers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "construct"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "construct": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "evidence",
        "inputs",
        "outputs",
        "depends_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "basic-script",
            "jupyter",
            "wrapper",
            "unresolved"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sequential",
        "runs"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "sequential": {
          "const": true
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "missing_evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "missing_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
